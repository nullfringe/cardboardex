{
  "name": "cardboardex",
  "version": "0.1.0",
  "private": true,
  "description": "A visual trading card collection manager.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "db:init": "node --import tsx src/scripts/db-init.ts",
    "db:import": "node --import tsx src/scripts/db-import.ts",
    "collection:sync": "node --import tsx src/scripts/collection-sync.ts",
    "db:seed": "node --import tsx src/scripts/db-seed.ts",
    "db:setup": "npm run db:init && npm run db:seed",
    "db:reset": "node --import tsx src/scripts/db-reset.ts",
    "artwork:sync": "node --import tsx src/scripts/artwork-sync.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:audit": "npm audit",
    "check": "npm run test && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "csv-parse": "^6.1.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "next": "^16.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.9"
  }
}
